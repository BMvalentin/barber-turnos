# ==============================================================================
# Archivo de ejemplo de variables de entorno — Barbería Turnos
# ------------------------------------------------------------------------------
# 1) Copiá este archivo a .env:
#      cp .env.example .env      (Linux/Mac)
#      copy .env.example .env    (Windows)
# 2) Completá cada valor siguiendo las guías paso a paso en la carpeta docs/.
# 3) NUNCA subas el archivo .env real al repositorio (está en .gitignore).
#
# Guía completa: abrir el archivo docs/README.md (índice de guías paso a paso)
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS (Prisma 7 + adaptador MariaDB)
# ──────────────────────────────────────────────────────────────────────────────
# URL completa usada por el CLI de Prisma (prisma.config.ts).
#   Local (XAMPP):  mysql://root:@127.0.0.1:3306/db_barber
#   TiDB Cloud:     mysql://USUARIO.CLUSTER:PASSWORD@HOST:4000/db_barber?sslaccept=strict
# Guía: docs/1-base-de-datos.md
DATABASE_URL="mysql://root:@127.0.0.1:3306/db_barber"

# Variables del adaptador nativo (src/lib/prisma.ts y prisma/seed.ts).
# Importante: usar 127.0.0.1 y NO "localhost" para evitar problemas de SSL en Windows.
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="db_barber"

# Opcional (solo TiDB Cloud): ruta al certificado CA dentro del proyecto.
# CA="./isrgrootx1.pem"


# ──────────────────────────────────────────────────────────────────────────────
# AUTH.JS (NextAuth v5) — login con Google
# ──────────────────────────────────────────────────────────────────────────────
# Generá el secreto con:  openssl rand -base64 32
# Guía: docs/3-secretos-y-url.md
AUTH_SECRET="TU_AUTH_SECRET_AQUI"

# Credenciales OAuth de Google (Guía: docs/2-google-oauth.md)
# Encontrás ID y Secret en: console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="TU_GOOGLE_CLIENT_SECRET"

# Requerido para desarrollo local (permite que Auth.js confíe en el host)
AUTH_TRUST_HOST=true


# ──────────────────────────────────────────────────────────────────────────────
# MERCADO PAGO (Checkout Pro + OAuth)
# ──────────────────────────────────────────────────────────────────────────────
# Aplicación creada en: mercadopago.com.ar/developers/panel/app
# Guía: docs/4-mercadopago.md
MP_CLIENT_ID="TU_MP_CLIENT_ID"
MP_CLIENT_SECRET="TU_MP_CLIENT_SECRET"

# Legacy / opcional: los tokens reales se guardan en la BD tras el OAuth
# (tabla configuracion_mercadopago). Solo se usan como respaldo/manual.
# MP_ACCESS_TOKEN="APP_USR-..."
# MP_PUBLIC_KEY="APP_USR-..."

# Opcional: base de autorización OAuth por país.
# Por defecto usa https://auth.mercadopago.com.ar (Argentina).
# MP_AUTH_BASE_URL="https://auth.mercadopago.com.ar"

# Secret para validar la firma de los webhooks de Mercado Pago (X-Signature).
# Se genera en el panel de la app. Sin él, el webhook falla cerrado en producción.
MP_WEBHOOK_SECRET=""


# ──────────────────────────────────────────────────────────────────────────────
# CLOUDINARY (imágenes de servicios/barberos)
# ──────────────────────────────────────────────────────────────────────────────
# Dashboard: console.cloudinary.com → Settings → Credentials
# Guía: docs/5-cloudinary.md
CLOUDINARY_CLOUD_NAME="TU_CLOUD_NAME"
CLOUDINARY_API_KEY="TU_API_KEY"
CLOUDINARY_API_SECRET="TU_API_SECRET"


# ──────────────────────────────────────────────────────────────────────────────
# URL DE LA APLICACIÓN
# ──────────────────────────────────────────────────────────────────────────────
# Desarrollo: http://localhost:3000
# Producción (Vercel): https://TU_APP.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# En Vercel se inyecta sola en runtime (no es necesario declararla).
# VERCEL_URL="TU_APP.vercel.app"
# IS_PRODUCTION=false


# ──────────────────────────────────────────────────────────────────────────────
# RESEND (envío de emails de turnos)
# ──────────────────────────────────────────────────────────────────────────────
# API keys: resend.com/api-keys
# Guía: docs/6-resend.md
RESEND_API_KEY="re_TU_RESEND_API_KEY"

# Remitente: usá "onboarding@resend.dev" en pruebas, o tu dominio verificado.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ──────────────────────────────────────────────────────────────────────────────
# CRON (expiración automática de turnos en Vercel)
# ──────────────────────────────────────────────────────────────────────────────
# Secret que protege /api/cron/expirar-turnos.
# Guía: docs/3-secretos-y-url.md
CRON_SECRET="TU_CRON_SECRET"
